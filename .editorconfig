root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,slnx,xml}]
indent_size = 2

[*.{ts,tsx,js,mjs,css}]
indent_size = 2

[*.cs]
# Layout and naming
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# Code quality
dotnet_diagnostic.IDE0005.severity = warning   # unused using
dotnet_diagnostic.IDE0051.severity = warning   # unused private member
dotnet_diagnostic.IDE0052.severity = warning   # private member assigned but never read
dotnet_diagnostic.IDE0059.severity = warning   # unnecessary assignment
dotnet_diagnostic.IDE0060.severity = warning   # unused parameter
dotnet_diagnostic.CA1852.severity = warning    # seal types that are never inherited
dotnet_diagnostic.CA2016.severity = warning    # forward the CancellationToken
dotnet_diagnostic.CA1305.severity = none       # the apps run with InvariantGlobalization
dotnet_diagnostic.CA1716.severity = none       # "Shared" is only reserved in VB; nothing here is consumed from VB

[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none       # xUnit test names use underscores
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1859.severity = none
