{
  "openapi": "3.1.1",
  "info": {
    "title": "Mocks.SourceApi | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5101/"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Admin"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/_admin/faults": {
      "get": {
        "tags": [
          "Admin"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "tags": [
          "Admin"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FaultSettings"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "Admin"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/_admin/faults/script": {
      "post": {
        "tags": [
          "Admin"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ScriptedFault"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/requisitions": {
      "get": {
        "tags": [
          "Requisitions"
        ],
        "summary": "List requisitions in change order (updatedAt, id) with a durable resume cursor.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "requester",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "updatedAfter",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Requisitions"
        ],
        "summary": "Create a requisition awaiting approval. The server assigns id, status and timestamps.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonObject"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/requisitions/{id}": {
      "get": {
        "tags": [
          "Requisitions"
        ],
        "summary": "Get one requisition; the ETag header carries its version.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/requisitions/{id}/erp-status": {
      "put": {
        "tags": [
          "Requisitions"
        ],
        "summary": "Write the ERP status back onto a requisition. Requires If-Match.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErpStatusUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/requisitions/{id}/withdraw": {
      "post": {
        "tags": [
          "Requisitions"
        ],
        "summary": "Withdraw a requisition that is still awaiting approval. Requires If-Match.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/_admin/seed-manifest": {
      "get": {
        "tags": [
          "Admin"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/_admin/reset": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Reload the data: dataset=Workbook (the client's workbook, default), Generated (seed, count) or Empty.",
        "parameters": [
          {
            "name": "dataset",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Dataset"
            }
          },
          {
            "name": "seed",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "count",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/_admin/requisitions": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Every record as stored (test evidence).",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/_admin/requisitions/{id}/raw": {
      "put": {
        "tags": [
          "Admin"
        ],
        "summary": "Store a record exactly as given, valid or not (test fixtures). version forces the version number.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonObject"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/_admin/requisitions/{id}": {
      "delete": {
        "tags": [
          "Admin"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/_admin/requisitions/{id}/hide-from-list": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Test fault: the list skips this record (as a lagging index would); GET by id still finds it.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hidden",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/_admin/requisitions/{id}/edit": {
      "post": {
        "tags": [
          "Admin"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonObject"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BodyTransform": {
        "enum": [
          "Truncate",
          "SetField"
        ]
      },
      "Dataset": {
        "enum": [
          "Workbook",
          "Generated",
          "Empty",
          null
        ]
      },
      "ErpStatusUpdate": {
        "required": [
          "erpReference",
          "erpStatus",
          "erpStatusAt",
          "message"
        ],
        "type": "object",
        "properties": {
          "erpReference": {
            "type": "string"
          },
          "erpStatus": {
            "type": "string"
          },
          "erpStatusAt": {
            "type": "string",
            "format": "date-time"
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "FaultKind": {
        "enum": [
          "None",
          "Error",
          "Throttle",
          "LostResponse",
          "Delay",
          "Abort",
          "Respond",
          "CommitThenRespond",
          "CommitThenTransform"
        ]
      },
      "FaultSettings": {
        "type": "object",
        "properties": {
          "transientErrorRate": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "throttleRate": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "throttleRetryAfterSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "lostResponseRate": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "latencyMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageOverlap": {
            "type": "boolean"
          },
          "honorIdempotencyKey": {
            "type": "boolean"
          },
          "referenceSearchLag": {
            "type": "boolean"
          },
          "seed": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "JsonObject": {
        "type": "object"
      },
      "ScriptedFault": {
        "required": [
          "kind"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/FaultKind"
          },
          "method": {
            "type": [
              "null",
              "string"
            ]
          },
          "pathContains": {
            "type": [
              "null",
              "string"
            ]
          },
          "count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "skip": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "statusCode": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "retryAfterSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "delayMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "bodyContains": {
            "type": [
              "null",
              "string"
            ]
          },
          "retryAfterAsDate": {
            "type": "boolean"
          },
          "omitRetryAfter": {
            "type": "boolean"
          },
          "body": {
            "type": [
              "null",
              "string"
            ]
          },
          "transform": {
            "$ref": "#/components/schemas/BodyTransform"
          },
          "field": {
            "type": [
              "null",
              "string"
            ]
          },
          "value": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Admin"
    },
    {
      "name": "Requisitions"
    }
  ]
}
