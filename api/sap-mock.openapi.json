  "components": {
    "schemas": {
      "BodyTransform": {
        "enum": [
          "Truncate",
          "SetField"
        ]
      },
      "Dataset": {
        "enum": [
          "Workbook",
          "Generated",
          null
        ]
      },
      "FaultKind": {
        "enum": [
          "None",
          "Error",
          "Throttle",
          "LostResponse",
          "Delay",
          "Abort",
          "Respond",
          "CommitThenRespond",
          "CommitThenTransform"
        ]
      },
      "FaultSettings": {
        "type": "object",
        "properties": {
          "TransientErrorRate": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "ThrottleRate": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "ThrottleRetryAfterSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "LostResponseRate": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "LatencyMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "PageOverlap": {
            "type": "boolean"
          },
          "HonorIdempotencyKey": {
            "type": "boolean"
          },
          "ReferenceSearchLag": {
            "type": "boolean"
          },
          "Seed": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "LifecycleChange": {
        "required": [
          "Lifecycle"
        ],
        "type": "object",
        "properties": {
          "Lifecycle": {
            "$ref": "#/components/schemas/SapLifecycle"
          }
        }
      },
      "PurchaseRequisitionInput": {
        "type": "object",
        "properties": {
          "PurchaseRequisitionType": {
            "type": [
              "null",
              "string"
            ]
          },
          "PurReqnDescription": {
            "type": [
              "null",
              "string"
            ]
          },
          "ExternalReference": {
            "type": [
              "null",
              "string"
            ]
          },
          "ExternalVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "to_PurchaseReqnItem": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/PurchaseRequisitionItemInput"
            }
          }
        }
      },
      "PurchaseRequisitionItemInput": {
        "type": "object",
        "properties": {
          "PurchaseRequisitionItem": {
            "type": [
              "null",
              "string"
            ]
          },
          "Material": {
            "type": [
              "null",
              "string"
            ]
          },
          "PurchaseRequisitionItemText": {
            "type": [
              "null",
              "string"
            ]
          },
          "MaterialGroup": {
            "type": [
              "null",
              "string"
            ]
          },
          "RequestedQuantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "BaseUnit": {
            "type": [
              "null",
              "string"
            ]
          },
          "PurchaseRequisitionPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "PurReqnItemCurrency": {
            "type": [
              "null",
              "string"
            ]
          },
          "Plant": {
            "type": [
              "null",
              "string"
            ]
          },
          "CompanyCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "PurchasingGroup": {
            "type": [
              "null",
              "string"
            ]
          },
          "TaxCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "DeliveryDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        }
      },
      "RawStatus": {
        "required": [
          "ProcessingStatus",
          "ReleaseStatus"
        ],
        "type": "object",
        "properties": {
          "ProcessingStatus": {
            "type": [
              "null",
              "string"
            ]
          },
          "ReleaseStatus": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SapLifecycle": {
        "enum": [
          "Created",
          "InRelease",
          "Released",
          "PoCreated",
          "Closed",
          "Rejected"
        ]
      },
      "ScriptedFault": {
        "required": [
          "Kind"
        ],
        "type": "object",
        "properties": {
          "Kind": {
            "$ref": "#/components/schemas/FaultKind"
          },
          "Method": {
            "type": [
              "null",
              "string"
            ]
          },
          "PathContains": {
            "type": [
              "null",
              "string"
            ]
          },
          "Count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "Skip": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "StatusCode": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "RetryAfterSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "DelayMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "BodyContains": {
            "type": [
              "null",
              "string"
            ]
          },
          "RetryAfterAsDate": {
            "type": "boolean"
          },
          "OmitRetryAfter": {
            "type": "boolean"
          },
          "Body": {
            "type": [
              "null",
              "string"
            ]
          },
          "Transform": {
            "$ref": "#/components/schemas/BodyTransform"
          },
          "Field": {
            "type": [
              "null",
              "string"
            ]
          },
          "Value": {
            "type": [
              "null",
              "string"
            ]
          }
        }
