    "/_admin/reset": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Reset SAP: dataset=Workbook (pre-existing documents and the workbook's failure schedule, default) or Generated (empty).",
        "parameters": [
          {
            "name": "dataset",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Dataset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
