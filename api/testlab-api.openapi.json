  "components": {
    "schemas": {
      "AssistantCall": {
        "required": [
          "user",
          "scopes",
          "method",
          "path",
          "headers",
          "body",
          "anonymous"
        ],
        "type": "object",
        "properties": {
          "user": {
            "type": "string"
          },
          "scopes": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "headers": {
            "type": [
              "null",
              "object"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "body": {
            "type": [
              "null",
              "string"
            ]
          },
          "anonymous": {
            "type": "boolean"
          }
        }
      },
      "BodyTransform": {
        "enum": [
          "Truncate",
          "SetField"
        ]
      },
      "CrashRequest": {
        "required": [
          "point"
        ],
        "type": "object",
        "properties": {
          "point": {
            "type": "string"
          }
        }
      },
      "DbFaultRequest": {
        "required": [
          "kind",
          "match",
          "times"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "match": {
            "type": "string"
          },
          "times": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "FaultKind": {
        "enum": [
          "None",
          "Error",
          "Throttle",
          "LostResponse",
          "Delay",
          "Abort",
          "Respond",
          "CommitThenRespond",
          "CommitThenTransform"
        ]
      },
      "FaultSettings": {
        "type": "object",
        "properties": {
          "transientErrorRate": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "throttleRate": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "throttleRetryAfterSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "lostResponseRate": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "latencyMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageOverlap": {
            "type": "boolean"
          },
          "honorIdempotencyKey": {
            "type": "boolean"
          },
          "referenceSearchLag": {
            "type": "boolean"
          },
          "seed": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "GeneratorOptions": {
        "type": "object",
        "properties": {
          "count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "seed": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pendingPct": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "invalidPct": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "duplicatePct": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "existingInSapPct": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "missingFieldsPct": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "invalidCodesPct": {
