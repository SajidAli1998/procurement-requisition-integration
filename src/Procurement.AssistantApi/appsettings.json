{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Dataset": { "Source": "Workbook" },
  "ConnectionStrings": {
    "SyncStore": "Data Source=procsync.db"
  },
  "Assistant": {
    "SourceBaseUrl": "http://localhost:5101/",
    "MaxRequestAmount": 25000,
    "MaxLines": 20,
    "MaxQuantityPerLine": 1000,
    "MaxNeededByDays": 365,
    "RequestsPerMinute": 60,
    "IdempotencyRetention": "1.00:00:00"
  },
  "Auth": {
    "Issuer": "procurement-dev",
    "Audience": "procurement-assistant-api",
    "SigningKey": "DEV-ONLY-signing-key-not-for-production-0123456789"
  }
}
