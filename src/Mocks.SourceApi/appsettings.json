{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Seed": { "Value": 42, "Count": 250 },
  "RateLimit": { "PermitsPerSecond": 20, "Burst": 20 },
